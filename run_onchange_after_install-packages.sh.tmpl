#!/bin/sh
# Installs the full toolchain (CLI + GUI) and the mise runtimes.
# Idempotent. Re-run by chezmoi when this file or the mise tool list changes.
#
# mise tools hash: {{ include "dot_config/mise/config.toml.tmpl" | sha256sum }}
# fish plugins hash: {{ include "dot_config/fish/fish_plugins" | sha256sum }}

set -eu

echo "==> Bootstrapping (machine: {{ .machine }})"

# --- Homebrew ---
if ! command -v brew >/dev/null 2>&1; then
    echo "==> Installing Homebrew"
    NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
eval "$(/opt/homebrew/bin/brew shellenv)"

# --- CLI tools ---
echo "==> Installing CLI tools"
brew install fish micro mise eza bat fd fzf git-delta jj

# --- GUI apps ---
echo "==> Installing GUI apps"
brew install --cask ghostty zed

# --- make fish the default shell ---
fish_path="$(command -v fish)"
if ! grep -qxF "$fish_path" /etc/shells 2>/dev/null; then
    echo "==> Registering fish in /etc/shells (may prompt for sudo)"
    echo "$fish_path" | sudo tee -a /etc/shells >/dev/null
fi
if [ "${SHELL:-}" != "$fish_path" ]; then
    echo "==> Setting fish as the default shell"
    chsh -s "$fish_path"
fi

# --- fish plugins (Fisher + agnoster prompt) ---
if ! fish -c 'functions -q fisher' 2>/dev/null; then
    echo "==> Installing Fisher"
    fish -c 'curl -sL https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish | source; and fisher install jorgebucaran/fisher'
fi
echo "==> Installing fish plugins"
fish -c 'fisher update'

# --- mise runtimes ---
echo "==> Installing runtimes from ~/.config/mise/config.toml"
mise install

echo "==> Done. Open a new terminal to start using fish."
