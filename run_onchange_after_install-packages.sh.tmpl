#!/bin/sh
# Installs the base toolchain (Homebrew, fish, micro, mise) + mise runtimes.
# Idempotent. Re-run by chezmoi when this file or the mise tool list changes.
#
# mise tools hash: {{ include "dot_config/mise/config.toml.tmpl" | sha256sum }}

set -eu

echo "==> Bootstrapping toolchain (machine: {{ .machine }})"

# --- Homebrew ---
if ! command -v brew >/dev/null 2>&1; then
    echo "==> Installing Homebrew"
    NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
eval "$(/opt/homebrew/bin/brew shellenv)"

# --- fish ---
if ! command -v fish >/dev/null 2>&1; then
    echo "==> Installing fish"
    brew install fish
fi
fish_path="$(command -v fish)"
if ! grep -qxF "$fish_path" /etc/shells 2>/dev/null; then
    echo "==> Registering fish in /etc/shells (may prompt for sudo)"
    echo "$fish_path" | sudo tee -a /etc/shells >/dev/null
fi
if [ "${SHELL:-}" != "$fish_path" ]; then
    echo "==> Setting fish as the default shell"
    chsh -s "$fish_path"
fi

# --- micro ---
if ! command -v micro >/dev/null 2>&1; then
    echo "==> Installing micro"
    brew install micro
fi

# --- mise ---
if ! command -v mise >/dev/null 2>&1; then
    echo "==> Installing mise"
    brew install mise
fi
echo "==> Installing runtimes from ~/.config/mise/config.toml"
mise install

echo "==> Done. Open a new terminal to start using fish."
