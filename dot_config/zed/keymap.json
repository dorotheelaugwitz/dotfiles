// ~/.config/zed/keymap.json
//
// Translated from the most recent Cursor keybindings
// (~/Library/Application Support/Cursor/User/keybindings.json).
//
// What carried over:
//   * cmd-i opened Cursor's Composer/agent ("composerMode.agent").
//     In Zed, cmd-i toggles focus of the Agent panel.
//
// What did NOT carry over (Cursor/extension-specific, no Zed equivalent):
//   * The "-aipopup.action.modal.generate" / "-composer.openAsBar"
//     unbindings — these only disabled Cursor's own defaults.
//   * "dbtPowerUser.executeSQL" (cmd-enter) and
//     "dbtPowerUser.buildCurrentModel" (alt-cmd-enter) come from the
//     dbt Power User extension. Re-create them as Zed tasks/keybindings
//     once you've set up dbt in Zed.
[
  {
    "bindings": {
      "cmd-i": "agent::ToggleFocus"
    }
  }
]
